# Per-vehicle settings written at end-of-line provisioning.
TCU_VIN=WDB9634031L123456
TCU_APN=fleet.example.apn
# Cellular RATs ltecm may use (2g,3g,4g,5g) and how the preference is set
# on the modem: 3gpp (AT+WS46) or quectel (AT+QNWPREFCFG).
TCU_RATS=3g,4g,5g
TCU_MODEM_VENDOR=3gpp
TCU_BT_PHONE=00:00:00:00:00:00
TCU_IGN_GPIO=/sys/class/gpio/gpio42/value
TCU_BATT_IIO=/sys/bus/iio/devices/iio:device0
TCU_BATT_DIVIDER=11.0
